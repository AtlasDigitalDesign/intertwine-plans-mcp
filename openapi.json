{
  "openapi": "3.0.3",
  "info": {
    "title": "Intertwine House Plans: Plan Finder",
    "version": "1.2.2",
    "description": "Read-only search of residential designer Angela Kamer's coastal and Southern house plans, sold direct at intertwinehouseplans.com. Specs, photos, packages and current prices for 68 plan sets. Also an MCP server (Streamable HTTP) at /mcp.",
    "contact": {
      "name": "Atlas Digital Design",
      "url": "https://atlasdigital.design"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/AtlasDigitalDesign/intertwine-plans-mcp/blob/main/LICENSE"
    },
    "x-logo": {
      "url": "https://agents.intertwinehouseplans.com/icon.png"
    }
  },
  "servers": [
    {
      "url": "https://agents.intertwinehouseplans.com"
    }
  ],
  "paths": {
    "/plans.json": {
      "get": {
        "summary": "Every plan with specs, prices and photos",
        "operationId": "listPlans",
        "responses": {
          "200": {
            "description": "The catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/mcp/server-card.json": {
      "get": {
        "summary": "MCP server card",
        "operationId": "serverCard",
        "responses": {
          "200": {
            "description": "Server card describing the MCP endpoint and its six tools",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "summary": "MCP endpoint (JSON-RPC 2.0, Streamable HTTP, stateless, no auth)",
        "operationId": "mcp",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              },
              "examples": {
                "toolsList": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 1,
                    "method": "tools/list"
                  }
                },
                "searchPlans": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 2,
                    "method": "tools/call",
                    "params": {
                      "name": "search_plans",
                      "arguments": {
                        "elevated": true,
                        "elevator": true,
                        "maxSqFt": 2500
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Catalog": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "designer": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "plans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Plan"
            }
          }
        }
      },
      "Plan": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "bedrooms": {
            "type": "number"
          },
          "bathrooms": {
            "type": "number"
          },
          "heatedSqFt": {
            "type": "integer"
          },
          "stories": {
            "type": "integer"
          },
          "footprint": {
            "type": "string"
          },
          "widthFt": {
            "type": "number"
          },
          "depthFt": {
            "type": "number"
          },
          "foundation": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "elevated": {
            "type": "boolean"
          },
          "elevator": {
            "type": "boolean"
          },
          "driveUnder": {
            "type": "boolean"
          },
          "garageADU": {
            "type": "boolean"
          },
          "priceFrom": {
            "type": "number"
          },
          "regularPrice": {
            "type": "number"
          },
          "onSale": {
            "type": "boolean"
          },
          "image": {
            "type": "string",
            "format": "uri"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The plan's page on intertwinehouseplans.com"
          }
        }
      },
      "JsonRpcRequest": {
        "type": "object",
        "required": [
          "jsonrpc",
          "method"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": [
              "2.0"
            ]
          },
          "id": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "method": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      }
    }
  }
}